# OpenModel M2 — Environment Variables
# Copy this file to .env.m2 and fill in the values.

# Client API token — used by clients calling /v1/chat/completions
# Generate: head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40
CLIENT_TOKEN=

# Admin token — used for worker management on /api/v1/*
# Generate: head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40
AGENT_ADMIN_TOKEN=
