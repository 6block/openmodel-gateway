# OpenModel Gateway — Environment Variables
# Copy this file to .env and fill in the values.

# Client API token — the default key for /v1/chat/completions (api_keys in the
# config file take precedence; self-registered keys via /v1/register also work).
# Generate: head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40
CLIENT_TOKEN=

# Admin token — worker management + settlement admin on :9091. Operator god-mode:
# never expose the admin port to the public internet.
AGENT_ADMIN_TOKEN=

# Settlement (only needed when settlement.enabled: true in the config):
# private key of the settlement operator wallet (hex, no 0x). This wallet pays
# gas for submitSettlement and must match the contract's `operator`.
# Keep it OUT of the repo; inject via environment or a secrets manager.
OPERATOR_PRIVATE_KEY=
